<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SPOT.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outlineSoft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SPOT.Card.Deep" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surfaceDeep</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outlineSoft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SPOT.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="iconTint">@color/onPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SPOT.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="iconTint">@color/secondary</item>
        <item name="strokeColor">@color/outlineSoft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SPOT.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/errorContainer</item>
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="strokeColor">@color/error</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SPOT.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surfaceDeep</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/secondary</item>
        <item name="startIconTint">@color/secondary</item>
        <item name="endIconTint">@color/secondary</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>
</resources>
